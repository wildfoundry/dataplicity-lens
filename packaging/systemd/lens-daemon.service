[Unit]
Description=Lens read-only observation collector (explicit opt-in)
After=systemd-tmpfiles-setup.service
StartLimitIntervalSec=3600
StartLimitBurst=3

[Service]
Type=simple
User=lens-collector
Group=lens-collector
ExecStart=/usr/bin/lens-daemon
Restart=on-failure
RestartSec=300
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_NETLINK
IPAddressDeny=any
ReadWritePaths=/run/lens-report
InaccessiblePaths=-/var/lib/lens-publisher
LockPersonality=yes
MemoryDenyWriteExecute=yes
LimitCORE=0
MemorySwapMax=0
MemoryMax=256M
CPUQuota=10%
TasksMax=64
TimeoutStopSec=25

[Install]
WantedBy=multi-user.target
