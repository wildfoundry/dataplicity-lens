#!/usr/bin/env bash
# Explicit local administrative setup. Package hooks never invoke this helper.
# Keep setup codes private even if the helper is invoked with Bash tracing.
set +x
set -euo pipefail
if [[ $(id -u) != 0 ]]; then
  echo 'Run setup as administrator. Lens services themselves run without root.' >&2
  exit 1
fi
lens_name=$(hostname -s)
lens_server_url=https://app-api.dataplicity.com
lens_refresh=()
lens_syslog_mode=auto
lens_syslog_host=''
lens_syslog_port=''
while (($#)); do
  case "$1" in
    --name) lens_name=${2:?Missing name}; shift 2;;
    --server-url) lens_server_url=${2:?Missing server URL}; shift 2;;
    --refresh) lens_refresh=(--refresh); shift;;
    --no-syslog-upload) [[ $lens_syslog_mode != force ]] || { echo 'Conflicting syslog options' >&2; exit 2; }; lens_syslog_mode=off; shift;;
    --syslog-upload) [[ $lens_syslog_mode != off ]] || { echo 'Conflicting syslog options' >&2; exit 2; }; lens_syslog_mode=force; shift;;
    --syslog-host) lens_syslog_host=${2:?Missing syslog host}; shift 2;;
    --syslog-port) lens_syslog_port=${2:?Missing syslog port}; shift 2;;
    *) echo 'Usage: lens-reporting-enable [--name HOSTNAME] [--server-url HTTPS_ORIGIN] [--refresh] [--no-syslog-upload | --syslog-upload] [--syslog-host DNS_NAME [--syslog-port PORT]]' >&2; exit 2;;
  esac
done
lens_syslog_command=(/usr/bin/lens-publisher syslog-config)
lens_valid_syslog_host() {
  local LC_ALL=C
  local lens_label='[A-Za-z0-9]([A-Za-z0-9-]{0,61}[A-Za-z0-9])?'
  local lens_dns="^(${lens_label}\.)+${lens_label}$"
  [[ ${#lens_syslog_host} -le 253 && $lens_syslog_host =~ $lens_dns && ${lens_syslog_host##*.} =~ [A-Za-z] ]]
}
if [[ -n $lens_syslog_host ]]; then
  if [[ $lens_syslog_mode == off ]] || ! lens_valid_syslog_host; then
    echo 'Specify a DNS name for the TLS syslog collector only when forwarding is requested.' >&2
    exit 2
  fi
  lens_syslog_command+=(--host "$lens_syslog_host")
fi
if [[ -n $lens_syslog_port ]]; then
  if [[ -z $lens_syslog_host || ! $lens_syslog_port =~ ^[0-9]{1,5}$ ]] || ((10#$lens_syslog_port < 1 || 10#$lens_syslog_port > 65535)); then
    echo 'Specify a TLS syslog collector port from 1 to 65535 with --syslog-host.' >&2
    exit 2
  fi
  lens_syslog_command+=(--port "$lens_syslog_port")
fi
lens_publisher_was_active=0
if systemctl is-active --quiet lens-publisher.service; then lens_publisher_was_active=1; fi
lens_setup_failed() {
  local lens_rc=$?
  if [[ $lens_publisher_was_active == 1 ]]; then
    if systemctl start lens-publisher.service >/dev/null 2>&1; then
      echo 'Lens setup did not finish. The previous publisher was restarted; check its service status.' >&2
    else
      echo 'Lens setup did not finish and the previous publisher could not restart. Run: sudo systemctl status lens-publisher.service' >&2
    fi
  else
    echo 'Lens setup did not finish. Reporting has not been confirmed enabled.' >&2
  fi
  exit "$lens_rc"
}
trap lens_setup_failed ERR
systemd-sysusers /usr/lib/sysusers.d/lens-reporting.conf
systemd-tmpfiles --create /usr/lib/tmpfiles.d/lens-reporting.conf
systemctl stop lens-publisher.service
if ((${#lens_refresh[@]})) || ! runuser -u lens-publisher -- /usr/bin/lens-publisher status >/dev/null 2>&1; then
  if [[ -t 0 ]]; then
    IFS= read -r -s -p 'Dataplicity organisation or VPS setup code: ' lens_org_code
    printf '\n' >&2
  else
    IFS= read -r lens_org_code || [[ -n ${lens_org_code:-} ]]
  fi
  printf '%s' "$lens_org_code" | runuser -u lens-publisher -- /usr/bin/lens-publisher register --server-url "$lens_server_url" --name "$lens_name" "${lens_refresh[@]}"
  unset lens_org_code
fi
# The local daemon forwards logs; Lens only reports this local selection.
lens_syslog_conf=/etc/rsyslog.d/60-dataplicity-lens.conf
lens_syslog_enabled=0
lens_syslog_reason='disabled by --no-syslog-upload'
lens_other_path=0
if command -v dataplicity >/dev/null 2>&1 || command -v prelude-agent >/dev/null 2>&1 \
  || [[ -e /opt/dataplicity/syslog/device-log-token || -d /var/lib/dpagent || -d /etc/dataplicity ]]; then
  lens_other_path=1
fi
# Only inspect active configuration files, exclude our one managed destination.
for lens_conf in /etc/rsyslog.conf /etc/rsyslog.d/*.conf /etc/syslog-ng/syslog-ng.conf /etc/syslog-ng/conf.d/*.conf; do
  [[ -f "$lens_conf" && "$lens_conf" != "$lens_syslog_conf" ]] || continue
  if grep -Eiq 'dataplicity|dvcmgr\.net|device-gateway/logs' "$lens_conf"; then lens_other_path=1; fi
done
if [[ -e "$lens_syslog_conf" ]] && ! head -1 "$lens_syslog_conf" | grep -q '^# Managed by Dataplicity Lens\.'; then
  echo 'Existing Lens-named syslog configuration is not managed by Lens; refusing to overwrite it.' >&2
  exit 1
fi
if [[ $lens_syslog_mode != off ]]; then
  if [[ $lens_other_path == 1 && $lens_syslog_mode != force ]]; then
    lens_syslog_reason='existing Agent or Dataplicity forwarding detected; no second forwarding path configured'
  elif [[ "${lens_server_url%/}" != https://app-api.dataplicity.com && -z $lens_syslog_host ]]; then
    lens_syslog_reason='custom API origin: specify its TLS syslog collector with --syslog-host'
  elif ! command -v rsyslogd >/dev/null 2>&1; then
    lens_syslog_reason='rsyslog unavailable; install and configure your existing forwarder locally'
  else
    lens_ca=''
    for lens_candidate in /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt; do
      if [[ -r "$lens_candidate" ]]; then lens_ca=$lens_candidate; break; fi
    done
    if [[ -z "$lens_ca" ]]; then
      lens_syslog_reason='system CA bundle unavailable; forwarding left disabled'
    else
      mkdir -p /etc/rsyslog.d
      lens_config_stage=$(mktemp /etc/rsyslog.d/.dataplicity-lens.XXXXXX)
      chmod 0600 "$lens_config_stage"
      trap 'rm -f "${lens_config_stage:-}"' EXIT
      runuser -u lens-publisher -- "${lens_syslog_command[@]}" --ca-file "$lens_ca" > "$lens_config_stage"
      # Validation output may contain the inline credential. Never echo it.
      lens_validation=$(mktemp)
      chmod 0600 "$lens_validation"
      lens_tls_valid=0
      if rsyslogd -N1 -f "$lens_config_stage" > "$lens_validation" 2>&1; then
        lens_tls_valid=1
      elif grep -Eiq 'lmnsd_gtls|could not load.*gtls|gtls.*(not found|cannot|failed)' "$lens_validation"; then
        # Repair only a diagnosed missing TLS module using the OS package manager.
        # Keep package diagnostics private: repository URLs can themselves contain credentials.
        lens_dependency_log=$(mktemp)
        chmod 0600 "$lens_dependency_log"
        lens_dependency_installed=0
        echo 'Lens logs: installing the system rsyslog TLS module.'
        if command -v apt-get >/dev/null 2>&1; then
          if NEEDRESTART_MODE=l DEBIAN_FRONTEND=noninteractive apt-get -y install rsyslog-gnutls > "$lens_dependency_log" 2>&1; then lens_dependency_installed=1; fi
        elif command -v dnf >/dev/null 2>&1; then
          if NEEDRESTART_MODE=l dnf -y install rsyslog-gnutls > "$lens_dependency_log" 2>&1; then lens_dependency_installed=1; fi
        fi
        rm -f "$lens_dependency_log"
        if [[ $lens_dependency_installed == 1 ]] && rsyslogd -N1 -f "$lens_config_stage" > "$lens_validation" 2>&1; then
          lens_tls_valid=1
        else
          echo 'Lens logs could not enable TLS. Install rsyslog-gnutls with your OS package manager, then rerun this setup command. Reporting will still be enabled.' >&2
        fi
      fi
      if [[ $lens_tls_valid == 1 ]]; then
        mv -f "$lens_config_stage" "$lens_syslog_conf"
        if rsyslogd -N1 > "$lens_validation" 2>&1 && systemctl restart rsyslog.service >/dev/null 2>&1; then
          lens_syslog_enabled=1
          lens_syslog_reason='rsyslog TLS forwarding configured locally; warning and above; maximum 60 events per minute'
          if [[ $lens_syslog_mode == force && $lens_other_path == 1 ]]; then
            lens_syslog_reason='explicit --syslog-upload override despite another Dataplicity path; review duplicate sources'
          fi
        else
          lens_syslog_reason='rsyslog restart failed; forwarding left disabled'
        fi
      else
        lens_syslog_reason='rsyslog TLS configuration validation failed; check the local TLS module installation'
      fi
      rm -f "$lens_validation" "$lens_config_stage"
      trap - EXIT
    fi
  fi
fi
if [[ $lens_syslog_enabled == 0 ]]; then
  if [[ -f "$lens_syslog_conf" ]]; then
    rm -f "$lens_syslog_conf"
    systemctl restart rsyslog.service >/dev/null 2>&1 || { echo 'Could not stop existing Lens forwarding; resolve rsyslog locally before continuing.' >&2; exit 1; }
  fi
  runuser -u lens-publisher -- /usr/bin/lens-publisher configure --no-syslog-upload --reason "$lens_syslog_reason"
else
  runuser -u lens-publisher -- /usr/bin/lens-publisher configure --reason "$lens_syslog_reason"
fi
printf 'Lens syslog: %s\n' "$lens_syslog_reason"
systemctl daemon-reload
# The unprivileged observer never receives IPMI device access. Only the fixed,
# network-isolated sampler can publish a bounded local power measurement.
if command -v ipmitool >/dev/null 2>&1 && [[ -e /dev/ipmi0 || -e /dev/ipmi/0 ]]; then
  if ! systemctl enable --now lens-power-sample.timer; then
    printf 'Lens host power is unavailable; inspect lens-power-sample.service locally.\n' >&2
  fi
fi
systemctl enable --now lens-daemon.service lens-publisher.service
for lens_unit in lens-daemon.service lens-publisher.service; do
  if ! systemctl is-active --quiet "$lens_unit"; then
    echo "Lens reporting is not ready: $lens_unit is not active. Run: sudo journalctl -u $lens_unit -n 30 --no-pager" >&2
    false
  fi
done
printf 'Lens reporting enabled. The first report appears after local collection completes.\n'
if [[ $lens_syslog_enabled == 0 && $lens_syslog_mode != off && ( $lens_other_path == 0 || $lens_syslog_mode == force ) ]]; then
  printf 'Lens logs are disabled: %s\n' "$lens_syslog_reason" >&2
  if [[ $lens_syslog_mode == force && -n $lens_syslog_host ]]; then exit 1; fi
fi
trap - ERR
