[Unit]
Description=Lens environment ingress %i
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/lens-infra/ingress/%i/haproxy.cfg

[Service]
Type=notify
ExecStart=/usr/sbin/haproxy -Ws -f /var/lib/lens-infra/ingress/%i/haproxy.cfg -p /var/lib/lens-infra/ingress/%i/haproxy.pid
ExecReload=/usr/sbin/haproxy -c -f /var/lib/lens-infra/ingress/%i/haproxy.cfg
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure
RestartSec=2
KillMode=mixed
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/lens-infra/ingress/%i
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LimitCORE=0
